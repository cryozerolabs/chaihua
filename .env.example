MODEL_PROVIDER=zenmux
MODEL_BASE_URL=https://zenmux.ai/api/v1
API_KEY=your_api_key
IMAGE_API_FORMAT=openai
IMAGE_EDIT_ENCODING=multipart
IMAGE_GENERATION_PATH=/images/generations
IMAGE_EDIT_PATH=/images/edits
VISION_API_PATH=/chat/completions
DESIGN_MODEL=inclusionai/ming-image-0.1-design
LAYER_MODEL=inclusionai/ming-image-0.1-design-layer
VISION_MODEL=inclusionai/ling-3.0-flash-vl
PORT=3001

# Optional server storage directory; defaults to .data.
# DATA_DIR=.data

# Copy this template to .env and edit .env to switch platforms.
# API_KEY always means the current platform key and is read only by the backend.
# OpenAI-compatible platforms use IMAGE_API_FORMAT=openai.
# OpenRouter's native Image API uses the settings below:
# MODEL_PROVIDER=openrouter
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# API_KEY=your_api_key
# IMAGE_API_FORMAT=openrouter
# IMAGE_GENERATION_PATH=/images
# IMAGE_EDIT_PATH=/images
